# Where the local PGlite database lives. Default: ./.data/minddyte
# The packaging effort sets this per platform rather than changing code.
# MINDDYTE_DATA_DIR=./.data/minddyte

OLLAMA_BASE_URL=http://localhost:11434

# ── Hosted model (production) ────────────────────────────────────────────
# Set these and the app answers from a hosted provider over HTTPS. Leave them
# unset and it talks to an Ollama daemon on localhost instead, which is what a
# developer wants. Setting the key DISABLES the localhost fallback on purpose:
# a deployment that quietly tries 127.0.0.1 reports "no model" when the truth
# is "wrong key".
# HOSTED_API_KEY=
# HOSTED_BASE_URL=https://ollama.com/api
# HOSTED_MODEL_IDS=gpt-oss:120b-cloud,gemma4:31b-cloud
